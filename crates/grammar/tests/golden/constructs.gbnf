root ::= "{" space (root-id-kv root-tail-1) "}" space
root-id ::= "\"" "v" ([0-9]{1,3} "."){2} [0-9]{1,3} ("-beta")? "\"" space
root-id-kv ::= "\"id\"" space ":" space root-id
root-flag ::= ("true" | "false") space
root-flag-kv ::= "\"flag\"" space ":" space root-flag
root-mode ::= ("\"fast\"" | "2" | "true" | "null") space
root-mode-kv ::= "\"mode\"" space ":" space root-mode
root-count ::= "-"? ("0" | [1-9] [0-9]{0,15}) space
root-count-kv ::= "\"count\"" space ":" space root-count
root-ratio ::= "-"? ("0" | [1-9] [0-9]{0,15}) ("." [0-9]{1,15})? space
root-ratio-kv ::= "\"ratio\"" space ":" space root-ratio
point ::= "{" space point-x-kv "," space point-y-kv "}" space
point-x ::= ("-" ([1-9] | [1-3] [0-9] | "40") | ([0-9] | [1-9] [0-9] | "1" [0-1] [0-9] | "12" [0-5])) space
point-x-kv ::= "\"x\"" space ":" space point-x
point-y ::= ([2-4] ("." [0-9]{1,15})? | "5" ("." "0"{1,15})?) space
point-y-kv ::= "\"y\"" space ":" space point-y
root-points ::= "[" space point ("," space point){0,2} "]" space
root-points-kv ::= "\"points\"" space ":" space root-points
root-note ::= "\"\"" space
root-note-kv ::= "\"note\"" space ":" space root-note
root-tag ::= "\"" char{2,8} "\"" space
root-tag-kv ::= "\"tag\"" space ":" space root-tag
root-tail-7 ::= "," space root-tag-kv
root-tail-6 ::= ("," space root-note-kv)? root-tail-7
root-tail-5 ::= "," space root-points-kv root-tail-6
root-tail-4 ::= ("," space root-ratio-kv)? root-tail-5
root-tail-3 ::= ("," space root-count-kv)? root-tail-4
root-tail-2 ::= ("," space root-mode-kv)? root-tail-3
root-tail-1 ::= ("," space root-flag-kv)? root-tail-2
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
space ::= " "?
