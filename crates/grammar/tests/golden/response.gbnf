root ::= (query-index | inspect-node | rule-explain | summarize | final-answer)
query-index ::= "{" space query-index-kind-kv "," space query-index-name-kv "," space query-index-arguments-kv "}" space
query-index-kind ::= "\"tool_call\"" space
query-index-kind-kv ::= "\"kind\"" space ":" space query-index-kind
query-index-name ::= "\"query_index\"" space
query-index-name-kv ::= "\"name\"" space ":" space query-index-name
query-index-arguments-category ::= ("\"apps\"" | "\"dev\"" | "\"media\"" | "\"docs\"" | "\"cache\"" | "\"system\"" | "\"hidden\"" | "\"model\"" | "\"home\"") space
query-index-arguments-category-kv ::= "\"category\"" space ":" space query-index-arguments-category
query-index-arguments-level ::= ("\"safe\"" | "\"recoverable\"" | "\"check_yourself\"") space
query-index-arguments-level-kv ::= "\"level\"" space ":" space query-index-arguments-level
query-index-arguments-min-size-bytes ::= ([0-9] | [1-9] [0-9] | [1-9] [0-9]{2} | [1-9] [0-9]{3} | [1-9] [0-9]{4} | [1-9] [0-9]{5} | [1-9] [0-9]{6} | [1-9] [0-9]{7} | [1-9] [0-9]{8} | [1-9] [0-9]{9} | [1-9] [0-9]{10} | [1-9] [0-9]{11} | [1-9] [0-9]{12} | [1-9] [0-9]{13} | [1-9] [0-9]{14}) space
query-index-arguments-min-size-bytes-kv ::= "\"min_size_bytes\"" space ":" space query-index-arguments-min-size-bytes
query-index-arguments-inactive-days ::= ([0-9] | [1-9] [0-9] | [1-9] [0-9]{2} | [1-9] [0-9]{3} | [1-2] [0-9]{4} | "3" [0-5] [0-9]{3} | "36" [0-4] [0-9]{2} | "36500") space
query-index-arguments-inactive-days-kv ::= "\"inactive_days\"" space ":" space query-index-arguments-inactive-days
query-index-arguments-path-prefix ::= "\"" char{1,1024} "\"" space
query-index-arguments-path-prefix-kv ::= "\"path_prefix\"" space ":" space query-index-arguments-path-prefix
query-index-arguments-limit ::= ([1-9] | [1-4] [0-9] | "50") space
query-index-arguments-limit-kv ::= "\"limit\"" space ":" space query-index-arguments-limit
query-index-arguments-tail-5 ::= ("," space query-index-arguments-limit-kv)?
query-index-arguments-tail-4 ::= ("," space query-index-arguments-path-prefix-kv)? query-index-arguments-tail-5
query-index-arguments-tail-3 ::= ("," space query-index-arguments-inactive-days-kv)? query-index-arguments-tail-4
query-index-arguments-tail-2 ::= ("," space query-index-arguments-min-size-bytes-kv)? query-index-arguments-tail-3
query-index-arguments-tail-1 ::= ("," space query-index-arguments-level-kv)? query-index-arguments-tail-2
query-index-arguments ::= "{" space (query-index-arguments-category-kv query-index-arguments-tail-1 | query-index-arguments-level-kv query-index-arguments-tail-2 | query-index-arguments-min-size-bytes-kv query-index-arguments-tail-3 | query-index-arguments-inactive-days-kv query-index-arguments-tail-4 | query-index-arguments-path-prefix-kv query-index-arguments-tail-5 | query-index-arguments-limit-kv)? "}" space
query-index-arguments-kv ::= "\"arguments\"" space ":" space query-index-arguments
inspect-node ::= "{" space inspect-node-kind-kv "," space inspect-node-name-kv "," space inspect-node-arguments-kv "}" space
inspect-node-kind ::= "\"tool_call\"" space
inspect-node-kind-kv ::= "\"kind\"" space ":" space inspect-node-kind
inspect-node-name ::= "\"inspect_node\"" space
inspect-node-name-kv ::= "\"name\"" space ":" space inspect-node-name
inspect-node-arguments-path ::= "\"" char{1,1024} "\"" space
inspect-node-arguments-path-kv ::= "\"path\"" space ":" space inspect-node-arguments-path
inspect-node-arguments ::= "{" space inspect-node-arguments-path-kv "}" space
inspect-node-arguments-kv ::= "\"arguments\"" space ":" space inspect-node-arguments
rule-explain ::= "{" space rule-explain-kind-kv "," space rule-explain-name-kv "," space rule-explain-arguments-kv "}" space
rule-explain-kind ::= "\"tool_call\"" space
rule-explain-kind-kv ::= "\"kind\"" space ":" space rule-explain-kind
rule-explain-name ::= "\"rule_explain\"" space
rule-explain-name-kv ::= "\"name\"" space ":" space rule-explain-name
rule-explain-arguments-id ::= "\"" [a-z] [a-z0-9.\-]{0,63} "\"" space
rule-explain-arguments-id-kv ::= "\"id\"" space ":" space rule-explain-arguments-id
rule-explain-arguments ::= "{" space rule-explain-arguments-id-kv "}" space
rule-explain-arguments-kv ::= "\"arguments\"" space ":" space rule-explain-arguments
summarize ::= "{" space summarize-kind-kv "," space summarize-name-kv "," space summarize-arguments-kv "}" space
summarize-kind ::= "\"tool_call\"" space
summarize-kind-kv ::= "\"kind\"" space ":" space summarize-kind
summarize-name ::= "\"summarize\"" space
summarize-name-kv ::= "\"name\"" space ":" space summarize-name
summarize-arguments ::= "{" space "}" space
summarize-arguments-kv ::= "\"arguments\"" space ":" space summarize-arguments
final-answer ::= "{" space final-answer-kind-kv "," space final-answer-answer-kv "," space final-answer-hypotheses-kv "}" space
final-answer-kind ::= "\"final\"" space
final-answer-kind-kv ::= "\"kind\"" space ":" space final-answer-kind
final-answer-answer ::= "\"" char{1,1500} "\"" space
final-answer-answer-kv ::= "\"answer\"" space ":" space final-answer-answer
final-answer-hypotheses-item-path ::= "\"" char{1,1024} "\"" space
final-answer-hypotheses-item-path-kv ::= "\"path\"" space ":" space final-answer-hypotheses-item-path
final-answer-hypotheses-item-guess ::= "\"" char{1,200} "\"" space
final-answer-hypotheses-item-guess-kv ::= "\"guess\"" space ":" space final-answer-hypotheses-item-guess
final-answer-hypotheses-item-confidence ::= ("0" ("." [0-9]{1,15})? | "1" ("." "0"{1,15})?) space
final-answer-hypotheses-item-confidence-kv ::= "\"confidence\"" space ":" space final-answer-hypotheses-item-confidence
final-answer-hypotheses-item ::= "{" space final-answer-hypotheses-item-path-kv "," space final-answer-hypotheses-item-guess-kv "," space final-answer-hypotheses-item-confidence-kv "}" space
final-answer-hypotheses ::= "[" space (final-answer-hypotheses-item ("," space final-answer-hypotheses-item){0,4})? "]" space
final-answer-hypotheses-kv ::= "\"hypotheses\"" space ":" space final-answer-hypotheses
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
space ::= " "?
